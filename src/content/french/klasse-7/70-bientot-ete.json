      "explanation": {
        "title": "Das futur composé",
        "paragraphs": [
          "Mit „aller + Infinitiv“ sprichst du über die nahe Zukunft: Je vais jouer. (Ich werde spielen.) Nous allons manger. (Wir werden essen.)",
          "„Aller“ wird konjugiert, das zweite Verb bleibt im Infinitiv."
        ],
        "examples": [
          {
            "fr": "Je vais faire du vélo.",
            "de": "Ich werde Rad fahren."
          },
          {
            "fr": "Nous allons manger.",
            "de": "Wir werden essen."
          }
        ],
        "tip": "Verneint wird nur „aller“: Je ne vais pas jouer."
      },
      "fills": [
        {
          "sentence": "Nous ___ manger.",
          "answer": "allons",
          "options": [
            "allons",
            "allez",
            "vont"
          ],
          "translation": "Wir werden essen.",
          "why": "Zu „nous“ passt „allons“."
        },
