        {"front":"l'infirmière","back":"die Krankenschwester","example":"L'infirmière aide les malades.","exampleDe":"Die Krankenschwester hilft den Kranken."},
        {"front":"l'ingénieur","back":"der Ingenieur","example":"Mon père est ingénieur.","exampleDe":"Mein Vater ist Ingenieur."}
