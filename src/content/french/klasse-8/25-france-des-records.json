        {
          "front": "plus … que",
          "back": "mehr … als / -er als",
          "example": "Léa est plus grande que Paul.",
          "exampleDe": "Léa ist größer als Paul."
        },
        {
          "front": "moins … que",
          "back": "weniger … als",
          "example": "Mon vélo est moins rapide que ta voiture.",
          "exampleDe": "Mein Rad ist weniger schnell als dein Auto."
        },
        {
          "front": "aussi … que",
          "back": "genauso … wie",
          "example": "Ma ville est aussi belle que Paris.",
          "exampleDe": "Meine Stadt ist so hübsch wie Paris."
        },
        {
          "front": "bon → meilleur(e)",
          "back": "gut → besser",
          "example": "Le gâteau est meilleur que la glace.",
          "exampleDe": "Der Kuchen ist besser als das Eis."
        },
        {
          "front": "bien → mieux",
          "back": "gut (Adverb) → besser",
          "example": "Il chante mieux que moi.",
          "exampleDe": "Er singt besser als ich."
        }
      ],
      "explanation": {
        "title": "Der Komparativ",
        "paragraphs": [
          "Mit „plus … que“ (mehr als), „moins … que“ (weniger als) und „aussi … que“ (genauso … wie) vergleichst du: Paris est plus grand que Nantes.",
          "Das Adjektiv richtet sich nach dem ersten Nomen."
        ],
        "examples": [
          {
            "fr": "Paris est plus grand que Nantes.",
            "de": "Paris ist größer als Nantes."
          },
          {
            "fr": "La Seine est aussi longue que la Loire.",
            "de": "Die Seine ist so lang wie die Loire."
          }
        ]
      },
      "fills": [
        {
          "sentence": "Paul est ___ grand que Léa.",
          "answer": "plus",
          "options": [
            "plus",
            "moins",
            "aussi"
          ],
          "translation": "Paul ist größer als Léa.",
          "why": "„plus … que“ = größer als."
        }
      ]
    },
    {
      "id": "f8-m2-l2",
      "title": "Der Superlativ",
      "items": [
        {
          "front": "le plus …",
          "back": "der / das am meisten …",
