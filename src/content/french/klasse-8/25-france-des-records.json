          "exampleDe": "Der Turm ist der höchste."
        },
        {
          "front": "le moins …",
          "back": "der am wenigsten …",
          "example": "C'est le moins cher.",
          "exampleDe": "Das ist der Billigste."
        },
        {
          "front": "le meilleur / la meilleure",
          "back": "der / die beste",
          "example": "C'est la meilleure glace.",
          "exampleDe": "Das ist das beste Eis."
        },
        {
          "front": "le pire",
          "back": "der / das Schlimmste",
