      ],
      "explanation": {
        "title": "Der Superlativ",
        "paragraphs": [
          "Mit „le plus“ / „la plus“ / „les plus“ drückst du das Höchste aus: La tour Eiffel est la plus haute tour de Paris.",
          "Das Gegenteil: „le moins“ (am wenigsten). „Le meilleur / la meilleure“ heißt „der beste / die beste“."
        ],
        "examples": [
          {
            "fr": "le plus grand, la plus longue",
            "de": "der größte, die längste"
          },
          {
            "fr": "C'est le meilleur gâteau.",
            "de": "Das ist der beste Kuchen."
          }
        ]
      },
      "fills": [
        {
          "sentence": "C'est ___ plus grand parc.",
          "answer": "le",
          "options": [
            "le",
            "la",
            "les"
          ],
          "translation": "Das ist der größte Park.",
          "why": "„parc“ ist männlich → le plus grand."
        }
      ]
    },
