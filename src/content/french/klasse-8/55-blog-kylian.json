      "explanation": {
        "title": "Besondere Adjektive",
        "paragraphs": [
          "Diese drei Adjektive haben eine zusätzliche Form vor Vokal: beau → bel, nouveau → nouvel, vieux → vieil. Weiblich: belle, nouvelle, vieille. Plural: beaux, nouveaux, vieux."
        ],
        "examples": [
          {
            "fr": "un beau jardin, un bel arbre, une belle plage",
            "de": "ein schöner Garten, ein schöner Baum, ein schöner Strand"
          },
          {
            "fr": "un nouveau livre, un nouvel ami, une nouvelle idée",
            "de": "ein neues Buch, ein neuer Freund, eine neue Idee"
          }
        ],
        "tip": "Vor Vokal klingen männlich und weiblich gleich: un bel arbre – une belle idée."
      },
