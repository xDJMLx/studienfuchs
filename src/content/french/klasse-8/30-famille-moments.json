    {
      "id": "f8-u3-l5",
      "title": "Relativsätze mit que",
      "items": [
        {
          "front": "que / qu'",
          "back": "den / die / das (Objekt)",
          "example": "Le film que j'aime est drôle.",
          "exampleDe": "Der Film, den ich mag, ist lustig."
        },
        {
          "front": "connaître",
          "back": "kennen",
          "example": "Je connais Léa.",
          "exampleDe": "Ich kenne Léa."
        },
        {
          "front": "le film que je regarde",
          "back": "der Film, den ich anschaue",
          "example": "Le film que je regarde est drôle.",
          "exampleDe": "Der Film, den ich anschaue, ist lustig."
        },
        {
          "front": "la fille que je connais",
          "back": "das Mädchen, das ich kenne",
          "example": "La fille que je connais est gentille.",
          "exampleDe": "Das Mädchen, das ich kenne, ist nett."
        },
        {
          "front": "la chose que je veux",
          "back": "das, was ich will",
          "example": "La chose que je veux est un vélo.",
          "exampleDe": "Was ich will, ist ein Fahrrad."
        }
      ],
      "explanation": {
        "title": "Das Relativpronomen que",
        "paragraphs": [
          "„Que“ ersetzt ein Objekt: Le livre que j'aime est ici. (Das Buch, das ich mag, ist hier.) Vor Vokal wird es zu „qu'“.",
          "Der Unterschied zu „qui“: Nach „qui“ folgt das Verb, nach „que“ ein Subjekt (je, tu, il …)."
        ],
        "examples": [
          {
            "fr": "Le livre que j'aime est ici.",
            "de": "Das Buch, das ich mag, ist hier."
          },
          {
            "fr": "La fille que je connais s'appelle Léa.",
            "de": "Das Mädchen, das ich kenne, heißt Léa."
          }
        ],
        "tip": "qui = Subjekt (Verb folgt), que = Objekt (Subjekt folgt)."
      },
      "fills": [
        {
          "sentence": "Le livre ___ j'aime est ici.",
          "answer": "que",
          "options": [
            "que",
            "qui",
            "où"
          ],
          "translation": "Das Buch, das ich mag, ist hier.",
          "why": "Nach dem Relativpronomen folgt „j'aime“ (Subjekt) → que."
        }
      ]
    },
