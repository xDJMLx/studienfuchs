    {
      "id": "f10-u3-l5",
      "title": "Pronomen lui und leur (1/2)",
      "explanation": {"title":"Das indirekte Objekt","paragraphs":["lui (ihm/ihr) und leur (ihnen) ersetzen à + Person: Je parle à Paul → Je lui parle. Je donne le livre à mes amis → Je leur donne le livre.","Bei Dingen nimmst du y: Je pense à ça → J'y pense. Reihenfolge bei zwei Pronomen: me/te/nous/vous – le/la/les – lui/leur – y – en."],"examples":[{"fr":"Je lui parle tous les jours.","de":"Ich spreche täglich mit ihm/ihr."},{"fr":"Il leur a donné le livre.","de":"Er hat ihnen das Buch gegeben."}]},
      "items": [
        {"front":"je lui parle","back":"ich spreche mit ihm/ihr","example":"Je lui parle tous les jours.","exampleDe":"Ich spreche täglich mit ihm."},
        {"front":"je leur parle","back":"ich spreche mit ihnen","example":"Je leur parle souvent.","exampleDe":"Ich spreche oft mit ihnen."},
        {"front":"il lui répond","back":"er antwortet ihm/ihr","example":"Il lui répond tout de suite.","exampleDe":"Er antwortet ihm sofort."},
        {"front":"elle leur écrit","back":"sie schreibt ihnen","example":"Elle leur écrit une carte.","exampleDe":"Sie schreibt ihnen eine Karte."}
      ]
    },
    {
      "id": "f10-u3-l6",
      "title": "Pronomen lui und leur (2/2)",
      "items": [
        {"front":"je le lui donne","back":"ich gebe es ihm/ihr","example":"Je le lui donne demain.","exampleDe":"Ich gebe es ihm morgen."},
        {"front":"je les leur montre","back":"ich zeige sie ihnen","example":"Je les leur montre demain.","exampleDe":"Ich zeige sie ihnen morgen."},
        {"front":"je te le dis","back":"ich sage es dir","example":"Je te le dis, c'est vrai.","exampleDe":"Ich sage es dir, es ist wahr."},
        {"front":"il me l'a donné","back":"er hat es mir gegeben","example":"Il me l'a donné hier.","exampleDe":"Er hat es mir gestern gegeben."}
      ],
      "fills": [
        {"sentence":"Je parle à Paul : je ___ parle.","answer":"lui","options":["lui","le","leur","y"],"translation":"Ich spreche mit Paul: ich spreche mit ihm.","why":"parler à + Person → lui."},
        {"sentence":"Il donne le livre à ses amis : il ___ donne le livre.","answer":"leur","options":["leur","lui","les","en"],"translation":"Er gibt das Buch seinen Freunden.","why":"à + mehrere Personen → leur."}
      ]
    }
