      "title": "Indirekte Rede (Gegenwart) (1/2)",
      "items": [
        {
          "front": "il dit que",
          "back": "er sagt, dass",
          "example": "Il dit que tout va bien.",
          "exampleDe": "Er sagt, dass alles in Ordnung ist."
        },
        {
          "front": "il demande si",
          "back": "er fragt, ob",
          "example": "Il demande si tu viens.",
          "exampleDe": "Er fragt, ob du kommst."
        },
        {
          "front": "elle explique que",
          "back": "sie erklärt, dass",
          "example": "Elle explique que c'est difficile.",
          "exampleDe": "Sie erklärt, dass es schwierig ist."
        },
        {
          "front": "ils répondent que",
          "back": "sie antworten, dass",
          "example": "Ils répondent qu'ils sont prêts.",
          "exampleDe": "Sie antworten, dass sie bereit sind."
        }
      ],
      "explanation": {
        "title": "Aussagen wiedergeben",
        "paragraphs": [
          "Aussage: Il dit que + Satz. Frage mit Ja/Nein: Il demande si + Satz. Befehl: Il dit de + Infinitiv.",
          "Wenn das einleitende Verb im Präsens steht, ändern sich die Zeiten nicht, nur Pronomen und Orts-/Zeitangaben passen sich an."
        ],
        "examples": [
          {
            "fr": "Paul dit : « Je suis fatigué. » → Paul dit qu'il est fatigué.",
            "de": "Paul sagt, dass er müde ist."
          },
          {
            "fr": "Elle demande : « Tu viens ? » → Elle demande si tu viens.",
            "de": "Sie fragt, ob du kommst."
          }
        ]
      }
    },
